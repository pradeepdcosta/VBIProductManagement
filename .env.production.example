# Settings for the server install (docker-compose.prod.yml).
# Copy to .env next to docker-compose.prod.yml and fill in. Never commit the filled-in file.

# Password for the portal's own PostgreSQL database (choose any strong value)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# First portal login, created on first start while no users exist.
# Sign in with it, then add everyone else under Admin → Users.
INITIAL_ADMIN_EMAIL=someone@vodafone.com
INITIAL_ADMIN_PASSWORD=change-me-min-8-chars

# Port the portal listens on, on this server
PORTAL_PORT=3001

# Placeholder figures for Cost Management, Trading Performance and the product drawer
# (shown until real data is entered). true = show placeholders.
SEED_DEMO_DATA=true

# true when users reach the portal over https (recommended).
# Set false ONLY if the portal is opened over plain http (e.g. http://server:3001),
# otherwise sign-in will not stick.
COOKIE_SECURE=true
