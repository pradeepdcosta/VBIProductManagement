# Keep secrets, local data and build output out of the Docker image
.git
.claude
.env
.env.*
!.env.example
!.env.production.example
backups
node_modules
client/node_modules
server/node_modules
client/dist
# The taxonomy and NPD workbooks are uploaded through Admin, not baked into the image
# (data/prods.xlsx is the starter list used on first start, so it stays)
data/*.xlsx
!data/prods.xlsx
*.log
